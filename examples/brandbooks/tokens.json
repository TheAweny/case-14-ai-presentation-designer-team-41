{
  "colors": {
    "primary": {
      "$type": "color",
      "$value": "#1746A2",
      "role": "primary"
    },
    "accent": {
      "$type": "color",
      "$value": "#E85D3F",
      "role": "accent"
    },
    "background": {
      "$type": "color",
      "$value": "#F7F8FC",
      "role": "background"
    },
    "text": {
      "$type": "color",
      "$value": "#17213A",
      "role": "text"
    },
    "link": {
      "$type": "color",
      "$value": "{colors.primary}"
    }
  },
  "typography": {
    "heading": {
      "$type": "fontFamily",
      "$value": "Arial",
      "role": "heading"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Arial",
      "role": "body"
    },
    "headingSize": {
      "$type": "fontSize",
      "$value": "36pt",
      "role": "heading"
    },
    "bodySize": {
      "$type": "fontSize",
      "$value": "20pt",
      "role": "body"
    }
  },
  "spacing": {
    "gutter": {
      "$type": "spacing",
      "$value": {
        "value": 24,
        "unit": "px"
      }
    }
  }
}
