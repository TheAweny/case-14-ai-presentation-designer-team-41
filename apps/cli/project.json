{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli",
  "projectType": "application",
  "sourceRoot": "apps/cli/src",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.build.json", "cwd": "apps/cli" },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json", "cwd": "apps/cli" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/cli --max-warnings 0" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --passWithNoTests", "cwd": "apps/cli" }
    },
    "run-config": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node apps/cli/dist/main.js configs/run.example.yaml",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
