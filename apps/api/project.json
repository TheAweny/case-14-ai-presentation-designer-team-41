{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{workspaceRoot}/scripts/build-typescript.mjs"],
      "options": {
        "command": "node ../../scripts/build-typescript.mjs api",
        "cwd": "apps/api"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/main.js",
        "cwd": "apps/api"
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "apps/api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/api --max-warnings 0"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests",
        "cwd": "apps/api"
      }
    },
    "export-openapi": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": [
        "{workspaceRoot}/apps/docs/generated/openapi.json",
        "{workspaceRoot}/apps/docs/public/openapi.json",
        "{workspaceRoot}/apps/docs/content/docs/api/reference"
      ],
      "options": {
        "command": "tsx src/docs/export-openapi.ts",
        "cwd": "apps/api"
      }
    }
  }
}
