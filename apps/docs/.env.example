# Address of the product. The header link points here.
# The API console in the browser calls this origin when API_DOCS_ENABLED=true on the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical address of this site, used for metadata.
NEXT_PUBLIC_DOCS_URL=http://localhost:3002

# On the product web server, not here: redirects /docs/... to this host
# only for pages listed in apps/web/src/lib/docs-portal.ts.
# DOCS_PUBLIC_URL=https://docs.lct.aweny.link
