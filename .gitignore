# node
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
yarn-error.log

# build artifacts
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo

# nx
.nx/cache
.nx/workspace-data

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.mypy_cache/
