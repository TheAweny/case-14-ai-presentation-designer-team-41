# node
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
yarn-error.log

# build artifacts
dist/
build/
out/
.next/
.next-chat-e2e/
coverage/
*.tsbuildinfo

# nx
.nx/cache
.nx/workspace-data

# playwright
apps/web/test-results/
apps/web/playwright-report/

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.mypy_cache/
*.egg-info/

# runtime state: the directories stay, their contents never get committed
data/*
!data/.gitkeep
runs/*
!runs/.gitkeep
apps/*/runs/
apps/*/data/
*.db
*.db-journal
*.sqlite
mastra.db*

# secrets
.env
.env.*
!.env.example

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.codeassistant
.git_hidden_message

# AI trash
.claude/*
.cursor/*
.deepseek/*
.gemini/*
.grok/*
.openai/*
.perplexity/*
.poe/*
.sage/*
.think/*
.vllm/*

# next dev writes agent notes into the app on start
apps/web/AGENTS.md
apps/web/CLAUDE.md

# scratch output of local sessions: slide renders, unpacked templates, working plans
/tmp/
/plans/

# Playwright CLI session logs and page snapshots.
.playwright-cli/
