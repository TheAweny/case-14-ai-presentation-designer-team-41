# runtime state: the directories stay, their contents never get committed
data/*
!data/.gitkeep
runs/*
!runs/.gitkeep
*.db
*.db-journal
*.sqlite
mastra.db*

# secrets
.env
.env.*
!.env.example

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.codeassistant
.git_hidden_message

