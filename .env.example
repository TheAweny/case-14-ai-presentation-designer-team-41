# Copy to .env and fill in. Real keys never go into the repository.

# --- Ports and origins -------------------------------------------------------
# Port the NestJS API listens on.
API_PORT=3001
# Origin allowed by the API CORS policy.
WEB_ORIGIN=http://localhost:3000
# Base URL of the API as the browser sees it; baked into the web build.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Base URL of the API as the web server sees it. Inside compose this is the internal hostname;
# used by server-side (SSR) calls instead of NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://api:3001

# --- PostgreSQL --------------------------------------------------------------
# Docker Compose defaults are intentionally local-only. Change these for any shared deployment.
POSTGRES_DB=lct26
POSTGRES_USER=lct26
POSTGRES_PASSWORD=lct26-local
POSTGRES_PORT=5433
# For running API/CLI directly on the host. Compose overrides this with the internal hostname.
DATABASE_URL=postgresql://lct26:lct26-local@localhost:5433/lct26

# --- Engine ------------------------------------------------------------------
# Base URL of the Python engine. Inside compose it stays on the internal network.
ENGINE_URL=http://localhost:8000
# Log level of the engine process: debug | info | warning | error.
ENGINE_LOG_LEVEL=info
# Optional host directory of original fonts, mounted read-only, not baked into images.
TEMPLATE_FONTS_DIR=./data/fonts

# --- Mastra ------------------------------------------------------------------
# LibSQL file used internally by Mastra workflow state; product run metadata lives in PostgreSQL.
MASTRA_STORAGE_URL=file:./runs/mastra.db

# --- Models ------------------------------------------------------------------
# Base URLs of the OpenAI-compatible runtimes that serve the models from configs/models.yaml.
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_MODEL=gpt://YOUR_FOLDER_ID/qwen3.6-35b-a3b/latest
VLM_BASE_URL=http://localhost:8081/v1
IMAGE_BASE_URL=http://localhost:8082/v1
# Model names as the runtime serves them. Empty: the Hugging Face repository from
# configs/models.yaml. Hosted providers often use their own names.
LLM_MODEL=
VLM_MODEL=
IMAGE_MODEL=
# Key for those runtimes. Local runtimes usually accept any non-empty value.
MODEL_API_KEY=local-development-key
# A separate stable key encrypts persisted per-user provider keys in PostgreSQL.
# Generate one with: openssl rand -base64 32
MODEL_SETTINGS_ENCRYPTION_KEY=replace-with-a-stable-secret
# Where answers come from: empty for the runtimes above, "fake" for recorded answers (tests,
# offline demo), "record" to call the runtimes and record what they answer.
MODEL_PROVIDER=
# Recorded answers for MODEL_PROVIDER=fake and record.
RECORDINGS_DIR=registry/recordings
# How the model is held to JSON: "schema" sends the answer's JSON Schema (structured output),
# "object" asks for any JSON object, "off" for a runtime that rejects response_format. The answer
# is validated against the schema in every mode.
MODEL_JSON_MODE=schema
# Requests to one runtime at once, for the whole run. Keep it under the provider's quota.
MODEL_MAX_CONCURRENCY=8

# --- Storage -----------------------------------------------------------------
# Where uploaded templates and content packs are kept.
DATA_DIR=./data
# Where run artifacts are written: decks, audit reports, manifests, previews.
RUNS_DIR=./runs

# --- Accounts ----------------------------------------------------------------
# Web reads these from apps/web/.env.local when run with `next dev`.
# Signs session cookies. Required in production: `openssl rand -base64 32`.
# Required by the production web container; replace this local example with a random secret.
AUTH_SECRET=lct26-local-auth-secret-change-me
# Accounts, `;`-separated: email:password:Display name. There is no self sign-up.
AUTH_USERS=admin@example.com:123123:Administrator

# Text generation uses only the configured Yandex model; images remain mocked.
# Set absolute repository paths when starting the API outside the workspace root.
REGISTRY_DIR=
