# Copy to .env and fill in. Real keys never go into the repository.

# --- Ports and origins -------------------------------------------------------
# Port the NestJS API listens on. The API answers only the web server: browsers go through the
# web's /api/backend proxy, and compose publishes the port on 127.0.0.1 alone.
API_PORT=3001
# Host ports and public address, selected by lct onboard. API stays on loopback.
API_HOST_PORT=3001
WEB_PORT=3000
WEB_BIND=0.0.0.0
APP_ORIGIN=
# HTTP installations need non-secure cookies; the HTTPS wizard sets this to true.
SESSION_COOKIE_SECURE=false
# Optional domain; the https profile starts Caddy with automatic certificate renewal.
LCT_DOMAIN=
LCT_PUBLIC_HOST=
LCT_MODE=docker
# Search can be disabled by the installer; the https profile is added for a domain.
COMPOSE_PROFILES=search
# API reference pages and OpenAPI JSON are off unless explicitly enabled.
API_DOCS_ENABLED=false
# Base URL of the API as the web server sees it: the compose service name, or
# http://localhost:3001 when the web runs with `next dev`.
API_INTERNAL_URL=http://api:3001

# --- PostgreSQL --------------------------------------------------------------
# The installer replaces the example password on a new installation and preserves it afterwards.
POSTGRES_DB=lct26
POSTGRES_USER=lct26
POSTGRES_PASSWORD=lct26-local
POSTGRES_PORT=5433
# For running API/CLI directly on the host. Compose overrides this with the internal hostname.
DATABASE_URL=postgresql://lct26:lct26-local@localhost:5433/lct26

# --- Engine ------------------------------------------------------------------
# Base URL of the Python engine. Inside compose it stays on the internal network.
ENGINE_URL=http://localhost:8000
# Log level of the engine process: debug | info | warning | error.
ENGINE_LOG_LEVEL=info
# Optional host directory of original fonts, mounted read-only, not baked into images.
TEMPLATE_FONTS_DIR=./data/fonts

# --- Mastra ------------------------------------------------------------------
# LibSQL file used internally by Mastra workflow state; product run metadata lives in PostgreSQL.
MASTRA_STORAGE_URL=file:./runs/mastra.db

# --- Models ------------------------------------------------------------------
# Base URLs of the OpenAI-compatible runtimes that serve the models from configs/models.yaml.
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# Qwen3.6-35B-A3B is about 35.95B and is outside the case cap. Serve the catalogue model instead:
# Qwen/Qwen3-30B-A3B-Instruct-2507 (30.5B). Leave LLM_MODEL empty to use that repository name.
VLM_BASE_URL=http://localhost:8081/v1
IMAGE_BASE_URL=http://localhost:8082/v1
# Model names as the runtime serves them. Empty: the Hugging Face repository from
# configs/models.yaml. Hosted providers often use their own names.
LLM_MODEL=
VLM_MODEL=
IMAGE_MODEL=
# Key for those runtimes. Local runtimes usually need none.
MODEL_API_KEY=
# Headers the runtime asks for besides the key, as Name=value pairs separated by commas. VK AI
# Space wants its project: MODEL_HEADERS=Project-ID=<project id>. Not for secrets: the key goes above.
MODEL_HEADERS=
# How a config run (lct generate) turns the model's thinking off: reasoning-effort for gateways
# that take reasoning_effort (OpenRouter, OpenAI-style), enable-thinking for vLLM-style
# chat_template_kwargs. Empty: nothing is sent, and a model that thinks by default keeps thinking
# and may run out of time. The interface keeps this per model in its settings instead.
MODEL_REASONING_TOGGLE=
# Where answers come from: empty for the runtimes above, "fake" for recorded answers (tests,
# offline demo), "record" to call the runtimes and record what they answer.
MODEL_PROVIDER=
# Pictures: the model of the Illustrator role in the settings draws them; without one,
# IMAGE_BASE_URL and IMAGE_MODEL together (OpenAI images API). "fake" draws one-colour pictures
# offline, for a demo. IMAGE_MAX_CONCURRENCY caps pictures drawn at once.
IMAGE_PROVIDER=
IMAGE_MAX_CONCURRENCY=3
# Recorded answers for MODEL_PROVIDER=fake and record.
RECORDINGS_DIR=registry/recordings
# How the model is held to JSON: "schema" sends the answer's JSON Schema (structured output),
# "object" asks for any JSON object, "off" for a runtime that rejects response_format. The answer
# is validated against the schema in every mode.
MODEL_JSON_MODE=schema
# Requests to the text model at once, shared by all runs, variants and the chat. Keep it under
# the provider's quota. After a 429 the API halves it on its own and grows it back as answers come.
MODEL_MAX_CONCURRENCY=8

# --- Storage -----------------------------------------------------------------
# Where uploaded templates and content packs are kept.
DATA_DIR=./data
# Where run artifacts are written: decks, audit reports, manifests, previews.
RUNS_DIR=./runs

# --- Accounts ----------------------------------------------------------------
# Web reads these from apps/web/.env.local when run with `next dev`.
# Signs session cookies. Generated by `lct onboard`; required by the production web container.
AUTH_SECRET=
# The first administrator. There is no self sign-up: the administrator makes the other accounts
# in Settings → Users. `lct onboard` fills these in. The API makes this account at start if it
# does not exist. Once signed in, the password is changed in the interface; ADMIN_PASSWORD
# replaces it only when it changes here, at the next start of the API — that is how a forgotten
# password is reset (`lct user admin`). Keeping ADMIN_EMAIL brings the account back as an
# administrator if it was demoted or switched off.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Older list of accounts, `;`-separated: email:password:Display name. Accounts missing from the
# database are made at start; nothing else is changed.
AUTH_USERS=

# --- Installation secrets ----------------------------------------------------
# `lct onboard` generates each of them once per installation (32 random bytes) and keeps them on
# later runs. Never copy them from another installation or from this file.
# The shared token the web server presents to the API; the API refuses everything else.
API_SERVICE_TOKEN=
# Encrypts the model API keys added in the interface; the API stores only ciphertext. Changing
# it makes stored keys unreadable, and they have to be entered again.
MODEL_KEYS_SECRET=
# Whether connections added in the interface may point at loopback and private networks, for
# example a local Ollama. Off by default: the API would otherwise reach inside its own network.
MODEL_ALLOW_PRIVATE_HOSTS=false

# Text generation uses only the configured Yandex model; images remain mocked.
# Set absolute repository paths when starting the API outside the workspace root.
REGISTRY_DIR=

# --- Web search --------------------------------------------------------------
# Internal SearXNG on the compose network. The API calls GET /search?q=...&format=json.
# Unset uses http://search:8080. An explicit empty value disables search and the chat stays up.
WEB_SEARCH_URL=http://search:8080
# On the host (`next dev`), point this at an existing SearXNG you already run, for example
# WEB_SEARCH_URL=http://127.0.0.1:8080
# Optional stable key for the search container. Leave unset to generate a new one at each start.
# If you set it, keep it only in the uncommitted .env. Do not commit a value.
SEARXNG_SECRET=
