{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "run-store",
  "projectType": "library",
  "sourceRoot": "packages/run-store/src",
  "tags": ["scope:api", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{workspaceRoot}/scripts/build-typescript.mjs"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node ../../scripts/build-typescript.mjs run-store",
        "cwd": "packages/run-store"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json", "cwd": "packages/run-store" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/run-store --max-warnings 0" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --passWithNoTests", "cwd": "packages/run-store" }
    }
  }
}
