{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "input-validation",
  "projectType": "library",
  "sourceRoot": "packages/input-validation/src",
  "tags": ["scope:api", "type:lib"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.lib.json", "cwd": "packages/input-validation" },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json", "cwd": "packages/input-validation" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/input-validation --max-warnings 0" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --passWithNoTests", "cwd": "packages/input-validation" }
    }
  }
}
