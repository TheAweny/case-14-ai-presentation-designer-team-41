{
  "contract": "EditableDeckResponse",
  "valid": [
    {
      "name": "exported deck",
      "payload": {
        "schemaVersion": 1,
        "outputPath": "runs/output.pptx",
        "designSystem": { "schemaVersion": 1 },
        "slideCount": 1
      }
    }
