{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "slides": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "intent": {
            "minLength": 1,
            "type": "string"
          },
          "slideId": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "sourceRefs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "location": {
                  "description": "Location within the input content item.",
                  "minLength": 1,
                  "type": "string"
                },
                "sourceId": {
                  "description": "Stable identifier of an input content item.",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "type": "string"
                }
              },
              "required": [
                "sourceId",
                "location"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "slideId",
          "title",
          "intent",
          "sourceRefs"
        ],
        "type": "object"
      },
      "maxItems": 15,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "slides"
  ],
  "title": "DeckPlan",
  "type": "object"
}
