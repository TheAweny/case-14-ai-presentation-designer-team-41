{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "message": {
      "minLength": 1,
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "runId": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "stage": {
      "enum": [
        "validating",
        "parsing",
        "planning",
        "generating-variants",
        "auditing",
        "exporting"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "started",
        "completed",
        "failed"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "sequence",
    "stage",
    "status",
    "occurredAt"
  ],
  "title": "RunEvent",
  "type": "object"
}
