{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "type": "boolean"
    },
    "controls": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "collapsed": {
            "type": "boolean"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "like": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "like",
          "collapsed"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "signatures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "digest"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "variantsDistinct": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "signatures",
    "variantsDistinct",
    "controls",
    "accepted"
  ],
  "title": "VisualCompareResponse",
  "type": "object"
}
