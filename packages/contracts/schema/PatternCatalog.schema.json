{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "patterns": {
      "description": "At least one: a template with no usable arrangement is rejected at import.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "density": {
            "description": "Share of the slide its slots cover, which is what ranks patterns per variant.",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "intents": {
            "description": "Plan intents this pattern can serve. Empty when it serves none.",
            "items": {
              "enum": [
                "title",
                "agenda",
                "section",
                "statement",
                "bullets",
                "two-column",
                "kpi",
                "table",
                "chart",
                "quote",
                "image",
                "closing"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "occurrences": {
            "description": "How many times the template uses it. A pattern used once is still a pattern.",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "patternId": {
            "description": "Referred to by every SlideIR built on this pattern.",
            "minLength": 1,
            "type": "string"
          },
          "slots": {
            "description": "In reading order.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "box": {
                  "additionalProperties": false,
                  "description": "Where the template puts it, in EMU.",
                  "properties": {
                    "cx": {
                      "description": "Width in EMU.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "cy": {
                      "description": "Height in EMU.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "x": {
                      "description": "Left edge in EMU.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    },
                    "y": {
                      "description": "Top edge in EMU.",
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "cx",
                    "cy"
                  ],
                  "type": "object"
                },
                "maxChars": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Rough capacity at the template size. Null when the slot is not textual."
                },
                "optional": {
                  "description": "True when a slide built on this pattern may leave it empty.",
                  "type": "boolean"
                },
                "role": {
                  "description": "What belongs here, which decides what may be placed in it.",
                  "enum": [
                    "title",
                    "subtitle",
                    "body",
                    "bullet-list",
                    "kpi-value",
                    "kpi-caption",
                    "quote",
                    "table",
                    "chart",
                    "image",
                    "logo",
                    "footer",
                    "page-number",
                    "decoration"
                  ],
                  "type": "string"
                },
                "slotId": {
                  "description": "Unique within the pattern, stable across runs.",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "slotId",
                "role",
                "box",
                "optional",
                "maxChars"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "sourceParts": {
            "description": "Layout or slide parts this arrangement was observed on.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "patternId",
          "sourceParts",
          "intents",
          "slots",
          "occurrences",
          "density"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "description": "Incremented by any incompatible change.",
      "type": "number"
    },
    "templateHash": {
      "description": "Hash of the TemplateIR these patterns were found in.",
      "maxLength": 64,
      "minLength": 64,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "templateHash",
    "patterns"
  ],
  "title": "PatternCatalog",
  "type": "object"
}
