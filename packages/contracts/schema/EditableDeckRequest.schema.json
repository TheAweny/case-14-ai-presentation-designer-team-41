{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "outputPath": {
      "minLength": 1,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "type": "number"
    },
    "slides": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "minLength": 1,
            "type": "string"
          },
          "slideId": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "slideId",
          "title",
          "body"
        ],
        "type": "object"
      },
      "maxItems": 15,
      "minItems": 1,
      "type": "array"
    },
    "templatePath": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "templatePath",
    "outputPath",
    "slides"
  ],
  "title": "EditableDeckRequest",
  "type": "object"
}
