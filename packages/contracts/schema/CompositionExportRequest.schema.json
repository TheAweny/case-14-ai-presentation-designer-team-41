{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "briefYears": {
      "items": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
      },
      "type": "array"
    },
    "outputPath": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "slides": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "images": {
            "description": "Generated pictures for image slots. An image slot without one is removed on export, so no empty frame or blank card is left.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "fit": {
                  "description": "cover crops the picture to fill the box; contain fits it whole inside.",
                  "enum": [
                    "cover",
                    "contain"
                  ],
                  "type": "string"
                },
                "path": {
                  "description": "The picture file, relative to the run directory: media/<name>.png.",
                  "pattern": "^media\\/[\\w.-]+\\.(?:png|jpe?g)$",
                  "type": "string"
                },
                "purpose": {
                  "enum": [
                    "qr",
                    "illustration"
                  ],
                  "type": "string"
                },
                "slotId": {
                  "description": "An imageSlots id of the composition.",
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "slotId",
                "path",
                "fit"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "patternId": {
            "minLength": 1,
            "type": "string"
          },
          "speakerNotes": {
            "type": "string"
          },
          "texts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "slotId": {
                  "minLength": 1,
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "slotId",
                "text"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "visual": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "headers": {
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 5,
                        "minItems": 2,
                        "type": "array"
                      },
                      "kind": {
                        "const": "table",
                        "type": "string"
                      },
                      "rows": {
                        "items": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "maxItems": 7,
                        "minItems": 1,
                        "type": "array"
                      },
                      "slotId": {
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "slotId",
                      "headers",
                      "rows"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "categories": {
                        "items": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "maxItems": 8,
                        "minItems": 2,
                        "type": "array"
                      },
                      "chartType": {
                        "enum": [
                          "bar",
                          "column",
                          "line",
                          "pie"
                        ],
                        "type": "string"
                      },
                      "kind": {
                        "const": "chart",
                        "type": "string"
                      },
                      "series": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "name": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "values": {
                              "items": {
                                "type": "number"
                              },
                              "maxItems": 8,
                              "minItems": 2,
                              "type": "array"
                            }
                          },
                          "required": [
                            "name",
                            "values"
                          ],
                          "type": "object"
                        },
                        "maxItems": 5,
                        "minItems": 1,
                        "type": "array"
                      },
                      "slotId": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "xTitle": {
                        "type": "string"
                      },
                      "yTitle": {
                        "description": "The value axis title with its unit.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "slotId",
                      "chartType",
                      "categories",
                      "series",
                      "xTitle",
                      "yTitle"
                    ],
                    "type": "object"
                  }
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "A table or chart replacing one text slot. Absent or null: text only."
          }
        },
        "required": [
          "patternId",
          "texts",
          "speakerNotes"
        ],
        "type": "object"
      },
      "maxItems": 60,
      "minItems": 1,
      "type": "array"
    },
    "templatePath": {
      "minLength": 1,
      "type": "string"
    },
    "today": {
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "templatePath",
    "outputPath",
    "slides"
  ],
  "title": "CompositionExportRequest",
  "type": "object"
}
