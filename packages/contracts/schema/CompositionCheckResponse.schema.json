{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "lines": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "maxChars": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "maxLines": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ],
            "type": "string"
          },
          "slideIndex": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "slotId": {
            "type": "string"
          }
        },
        "required": [
          "slideIndex",
          "slotId",
          "code",
          "severity",
          "lines",
          "maxLines",
          "maxChars",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "findings"
  ],
  "title": "CompositionCheckResponse",
  "type": "object"
}
