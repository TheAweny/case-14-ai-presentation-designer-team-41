{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "outputDir": {
      "description": "Directory the PNG files are written into.",
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "templatePath": {
      "description": "The template .pptx, on the engine filesystem.",
      "minLength": 1,
      "type": "string"
    },
    "widthPx": {
      "description": "Width of every picture; the height follows the slide proportions.",
      "maximum": 1920,
      "minimum": 160,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "templatePath",
    "outputDir",
    "widthPx"
  ],
  "title": "TemplatePreviewsRequest",
  "type": "object"
}
