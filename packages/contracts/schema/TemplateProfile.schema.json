{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "palette": {
      "items": {
        "pattern": "^#[A-Fa-f0-9]{6}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "protectedElements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "additionalProperties": false,
            "properties": {
              "height": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "width": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "x": {
                "minimum": 0,
                "type": "number"
              },
              "y": {
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "type": "object"
          },
          "kind": {
            "enum": [
              "logo",
              "footer",
              "page-number",
              "background"
            ],
            "type": "string"
          },
          "objectId": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          }
        },
        "required": [
          "objectId",
          "kind",
          "bbox"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "slideSize": {
      "additionalProperties": false,
      "properties": {
        "heightPt": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "widthPt": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "widthPt",
        "heightPt"
      ],
      "type": "object"
    },
    "sourceSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "templateId": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "typography": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "family": {
            "minLength": 1,
            "type": "string"
          },
          "sizePt": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "weight": {
            "maximum": 900,
            "minimum": 100,
            "type": "integer"
          }
        },
        "required": [
          "family",
          "sizePt",
          "weight"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "templateId",
    "sourceSha256",
    "slideSize",
    "palette",
    "typography",
    "protectedElements"
  ],
  "title": "TemplateProfile",
  "type": "object"
}
