{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "objects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "additionalProperties": false,
            "properties": {
              "height": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "width": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "x": {
                "minimum": 0,
                "type": "number"
              },
              "y": {
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "type": "object"
          },
          "kind": {
            "enum": [
              "text",
              "shape",
              "image",
              "table",
              "chart",
              "diagram"
            ],
            "type": "string"
          },
          "objectId": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          }
        },
        "required": [
          "objectId",
          "kind",
          "bbox"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "slideId": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "slideId",
    "objects"
  ],
  "title": "SlideIR",
  "type": "object"
}
