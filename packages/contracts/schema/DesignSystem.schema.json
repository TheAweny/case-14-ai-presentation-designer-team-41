{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aspect": {
      "description": "Aspect ratio in lowest terms, such as 16:9.",
      "type": "string"
    },
    "assets": {
      "description": "Empty when the template carries no imagery.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "heightPx": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "mediaPart": {
            "description": "Part name inside the template package.",
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "enum": [
              "logo",
              "background",
              "decoration"
            ],
            "type": "string"
          },
          "widthPx": {
            "anyOf": [
              {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "mediaPart",
          "role",
          "widthPx",
          "heightPx"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "grid": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "description": "Vertical step layout snaps to, in EMU.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "columns": {
          "description": "Columns the content area divides into.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "gutter": {
          "description": "Space between columns in EMU.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "marginBottom": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "marginLeft": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "marginRight": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "marginTop": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "slideCx": {
          "description": "Slide width in EMU.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "slideCy": {
          "description": "Slide height in EMU.",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "slideCx",
        "slideCy",
        "marginLeft",
        "marginRight",
        "marginTop",
        "marginBottom",
        "columns",
        "gutter",
        "baseline"
      ],
      "type": "object"
    },
    "notes": {
      "description": "What had to be inferred, for a reader wondering why a value looks odd.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "palette": {
      "description": "One entry per role the template supports. Roles it lacks are simply absent.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "coverage": {
            "description": "Share of the template this colour covers. Zero for a purely declared value.",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "hex": {
            "description": "Six hex digits, no leading hash.",
            "pattern": "^[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "role": {
            "enum": [
              "background",
              "surface",
              "text",
              "text-muted",
              "text-on-accent",
              "accent",
              "accent-alt",
              "line",
              "positive",
              "negative"
            ],
            "type": "string"
          },
          "source": {
            "enum": [
              "observed",
              "theme",
              "fallback"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "hex",
          "source",
          "coverage"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "description": "Incremented by any incompatible change.",
      "type": "number"
    },
    "templateHash": {
      "description": "Hash of the TemplateIR this was derived from, so the pair can be checked.",
      "maxLength": 64,
      "minLength": 64,
      "type": "string"
    },
    "typeScale": {
      "description": "One entry per role in use.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "bold": {
            "type": "boolean"
          },
          "colorRole": {
            "description": "Which palette role this text takes its colour from.",
            "enum": [
              "background",
              "surface",
              "text",
              "text-muted",
              "text-on-accent",
              "accent",
              "accent-alt",
              "line",
              "positive",
              "negative"
            ],
            "type": "string"
          },
          "font": {
            "description": "Typeface to set this role in.",
            "minLength": 1,
            "type": "string"
          },
          "italic": {
            "type": "boolean"
          },
          "lineSpacing": {
            "description": "Multiple of the line height, 1 for single.",
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "role": {
            "enum": [
              "title",
              "subtitle",
              "heading",
              "body",
              "bullet",
              "caption",
              "kpi-value",
              "kpi-caption",
              "quote",
              "footer"
            ],
            "type": "string"
          },
          "sizePt": {
            "description": "Size in points.",
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "source": {
            "enum": [
              "observed",
              "theme",
              "fallback"
            ],
            "type": "string"
          }
        },
        "required": [
          "role",
          "font",
          "sizePt",
          "bold",
          "italic",
          "lineSpacing",
          "colorRole",
          "source"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "templateHash",
    "aspect",
    "palette",
    "typeScale",
    "grid",
    "assets",
    "notes"
  ],
  "title": "DesignSystem",
  "type": "object"
}
