{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findingId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The finding this answers. Null when the user asked for the change directly."
    },
    "ops": {
      "description": "Applied in order, all of them or none.",
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "elementId": {
                "minLength": 1,
                "type": "string"
              },
              "op": {
                "const": "set-text",
                "type": "string"
              },
              "paragraphs": {
                "description": "The new copy, already fitted.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "align": {
                      "anyOf": [
                        {
                          "enum": [
                            "left",
                            "center",
                            "right",
                            "justify"
                          ],
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Null or absent when the paragraph inherits its alignment."
                    },
                    "level": {
                      "description": "Indent level, zero at the top.",
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "lineSpacing": {
                      "anyOf": [
                        {
                          "exclusiveMinimum": 0,
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Multiple of single spacing, when stated as a percentage."
                    },
                    "runs": {
                      "description": "Runs in reading order.",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "bold": {
                            "description": "Null when inherited.",
                            "type": [
                              "boolean",
                              "null"
                            ]
                          },
                          "color": {
                            "description": "Six-digit hex when the run states a colour. Empty when it inherits one.",
                            "type": "string"
                          },
                          "font": {
                            "description": "Typeface named on the run. Empty when it inherits from the theme.",
                            "type": "string"
                          },
                          "italic": {
                            "description": "Null when inherited.",
                            "type": [
                              "boolean",
                              "null"
                            ]
                          },
                          "letterSpacingPt": {
                            "description": "Extra space between letters in points, as OOXML `spc`. Null or absent: inherited.",
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "sizePt": {
                            "description": "Size in points, or null when inherited.",
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "text": {
                            "description": "Literal text of the run.",
                            "type": "string"
                          },
                          "underline": {
                            "description": "Null or absent when inherited, which for almost every template means no underline.",
                            "type": [
                              "boolean",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "text",
                          "font",
                          "sizePt",
                          "bold",
                          "italic",
                          "color"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "level",
                    "runs",
                    "lineSpacing"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "op",
              "elementId",
              "paragraphs"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "elementId": {
                "minLength": 1,
                "type": "string"
              },
              "op": {
                "const": "set-font-size",
                "type": "string"
              },
              "sizePt": {
                "description": "Must be a size the DesignSystem type scale allows.",
                "exclusiveMinimum": 0,
                "type": "number"
              }
            },
            "required": [
              "op",
              "elementId",
              "sizePt"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "box": {
                "additionalProperties": false,
                "description": "New geometry in EMU, snapped to the template grid.",
                "properties": {
                  "cx": {
                    "description": "Width in EMU.",
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "cy": {
                    "description": "Height in EMU.",
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "x": {
                    "description": "Left edge in EMU.",
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  "y": {
                    "description": "Top edge in EMU.",
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "cx",
                  "cy"
                ],
                "type": "object"
              },
              "elementId": {
                "minLength": 1,
                "type": "string"
              },
              "op": {
                "const": "move",
                "type": "string"
              }
            },
            "required": [
              "op",
              "elementId",
              "box"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "colorRole": {
                "description": "A role, never a literal colour: the template supplies it.",
                "enum": [
                  "background",
                  "surface",
                  "text",
                  "text-muted",
                  "text-on-accent",
                  "accent",
                  "accent-alt",
                  "line",
                  "positive",
                  "negative"
                ],
                "type": "string"
              },
              "elementId": {
                "minLength": 1,
                "type": "string"
              },
              "op": {
                "const": "set-color",
                "type": "string"
              }
            },
            "required": [
              "op",
              "elementId",
              "colorRole"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "elementId": {
                "minLength": 1,
                "type": "string"
              },
              "op": {
                "const": "remove",
                "type": "string"
              }
            },
            "required": [
              "op",
              "elementId"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "repattern",
                "type": "string"
              },
              "patternId": {
                "description": "A pattern from the PatternCatalog of this template.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "op",
              "patternId"
            ],
            "type": "object"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "patchId": {
      "minLength": 1,
      "type": "string"
    },
    "rationale": {
      "description": "One sentence, shown next to the button that applies it.",
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "description": "Incremented by any incompatible change.",
      "type": "number"
    },
    "slideId": {
      "minLength": 1,
      "type": "string"
    },
    "touchesCopy": {
      "description": "True when a model wrote words here, which the manifest has to record.",
      "type": "boolean"
    },
    "variant": {
      "enum": [
        "dense",
        "balanced",
        "airy"
      ],
      "type": "string"
    }
  },
  "required": [
    "patchId",
    "findingId",
    "slideId",
    "variant",
    "ops",
    "rationale",
    "touchesCopy",
    "schemaVersion"
  ],
  "title": "FixPatch",
  "type": "object"
}
