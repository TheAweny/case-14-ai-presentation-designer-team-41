{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pipeline",
  "projectType": "library",
  "sourceRoot": "packages/pipeline/src",
  "tags": ["scope:api", "type:lib"],
  "targets": {
    "recovery-runtime": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/recovery/runtime.mjs", "cwd": "{workspaceRoot}" }
    },
    "recovery-restart": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/recovery/restart.mjs", "cwd": "{workspaceRoot}" }
    },
    "recovery-benchmark": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/recovery/content-benchmark.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.lib.json", "cwd": "packages/pipeline" },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json", "cwd": "packages/pipeline" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/pipeline --max-warnings 0" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --passWithNoTests", "cwd": "packages/pipeline" }
    },
    "compare-layout-remap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/compare-layout-remap.mts",
        "cwd": "."
      }
    }
  }
}
